---
import BaseLayout from '../layouts/BaseLayout.astro';
import CustomerForm from '../components/CustomerForm.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../config';
---
<BaseLayout title={`Crear Cliente | ${SITE_TITLE}`} description={SITE_DESCRIPTION}>
	<main>
		<h1>Crear Cliente</h1>
		<p>Registra un nuevo cliente en el sistema.</p>

		<CustomerForm />

		<p id="status" class="status"></p>

		<div id="result" class="result-card" style="display: none;"></div>
	</main>
</BaseLayout>

<style>
	main {
		max-width: 560px;
		margin: 0 auto;
		padding: 2rem 1rem;
	}

	h1 {
		margin-bottom: 0.25rem;
	}

	.status {
		min-height: 1.2rem;
		font-size: 0.9rem;
		margin-top: 1rem;
	}

	.status.error {
		color: #b00020;
	}

	.status.success {
		color: #2e7d32;
	}

	.result-card {
		margin-top: 1rem;
		border: 1px solid #e2e2e2;
		border-radius: 10px;
		padding: 1rem 1.25rem;
		background: #fafafa;
	}

	.result-card h3 {
		margin: 0 0 0.4rem 0;
		font-size: 1.05rem;
	}

	.result-card .meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.25rem;
		font-size: 0.9rem;
		color: #444;
	}

	.result-card .meta span strong {
		color: #111;
	}
</style>

<script>
	import { ApiError, createCustomer } from '../services/api';

	const form = document.getElementById('create-form');
	const statusEl = document.getElementById('status');
	const resultDiv = document.getElementById('result');

	function setStatus(msg, type) {
		statusEl.textContent = msg;
		statusEl.className = `status ${type}`;
	}

	function renderResult(customer) {
		resultDiv.style.display = 'block';
		resultDiv.innerHTML = `
	        <h3>✅ ${customer.firstName ?? ''} ${customer.lastName ?? ''}</h3>
		        <div class="meta">
	            <span><strong>ID:</strong> ${customer.id ?? '-'}</span>
	            <span><strong>Cuenta:</strong> ${customer.accountNumber ?? '-'}</span>
	            <span><strong>Saldo:</strong> $${customer.balance ?? '0'}</span>
	        </div>
	    `;
	}

	form.addEventListener('submit', async (e) => {
		e.preventDefault();
		resultDiv.style.display = 'none';

		const payload = {
			firstName: document.getElementById('firstName').value.trim(),
			lastName: document.getElementById('lastName').value.trim(),
			accountNumber: document.getElementById('accountNumber').value.trim(),
			balance: parseFloat(document.getElementById('balance').value),
		};

		if (!payload.firstName || !payload.lastName || !payload.accountNumber || isNaN(payload.balance)) {
			setStatus('Completa todos los campos correctamente.', 'error');
			return;
		}

		setStatus('Creando cliente...', '');

		try {
			const data = await createCustomer(payload);
			setStatus('Cliente creado exitosamente.', 'success');
			renderResult(data);
			form.reset();
		} catch (err) {
			if (err instanceof ApiError) {
				setStatus(err.message, 'error');
				return;
			}
			setStatus('No se pudo conectar con el backend. ¿Está corriendo en el puerto 8088?', 'error');
		}
	});
</script>
