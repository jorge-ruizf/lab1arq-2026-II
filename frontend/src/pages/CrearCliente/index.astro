---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const API_BASE = 'http://localhost:8088/api';
---
<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Crear Cliente | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Crear Cliente</h1>
			<p>Registra un nuevo cliente en el sistema.</p>

			<form id="create-form" class="customer-form">
				<div class="field">
				    <label for="firstName">Nombres</label>
				    <input id="firstName" name="firstName" type="text" placeholder="Juan" required />
				</div>

				<div class="field">
				    <label for="lastName">Apellidos</label>
				    <input id="lastName" name="lastName" type="text" placeholder="Pérez" required />
				</div>

				<div class="field">
				    <label for="accountNumber">Número de cuenta</label>
				    <input id="accountNumber" name="accountNumber" type="text" placeholder="ACC001" required />
				</div>

				<div class="field">
				    <label for="balance">Saldo inicial</label>
				    <input id="balance" name="balance" type="number" step="0.01" min="0" placeholder="1000.00" required />
				</div>

				<button type="submit" class="btn btn-primary">Crear cliente</button>
			</form>

			<p id="status" class="status"></p>

			<div id="result" class="result-card" style="display: none;"></div>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		max-width: 560px;
		margin: 0 auto;
		padding: 2rem 1rem;
	}

	h1 {
		margin-bottom: 0.25rem;
	}

	.customer-form {
		display: flex;
		flex-direction: column;
		gap: 1.1rem;
		margin-top: 1.5rem;
	}

	.field {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}

	label {
		font-size: 0.9rem;
		font-weight: 600;
		color: #333;
	}

	input {
		padding: 0.6rem 0.75rem;
		border: 1px solid #ccc;
		border-radius: 8px;
		font-size: 0.95rem;
	}

	input:focus {
		outline: none;
		border-color: #1a1a2e;
	}

	.btn {
		padding: 0.65rem 1.1rem;
		border: none;
		border-radius: 8px;
		font-size: 0.95rem;
		cursor: pointer;
		transition: opacity 0.15s ease;
	}

	.btn:hover {
		opacity: 0.85;
	}

	.btn-primary {
		background: #1a1a2e;
		color: white;
	}

	.status {
		min-height: 1.2rem;
		font-size: 0.9rem;
		margin-top: 1rem;
	}

	.status.error {
		color: #b00020;
	}

	.status.success {
		color: #2e7d32;
	}

	.result-card {
		margin-top: 1rem;
		border: 1px solid #e2e2e2;
		border-radius: 10px;
		padding: 1rem 1.25rem;
		background: #fafafa;
	}

	.result-card h3 {
		margin: 0 0 0.4rem 0;
		font-size: 1.05rem;
	}

	.result-card .meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.25rem;
		font-size: 0.9rem;
		color: #444;
	}

	.result-card .meta span strong {
		color: #111;
	}
</style>

<script define:vars={{ API_BASE }}>
	const form = document.getElementById('create-form');
	const statusEl = document.getElementById('status');
	const resultDiv = document.getElementById('result');

	function setStatus(msg, type) {
		statusEl.textContent = msg;
		statusEl.className = `status ${type}`;
	}

	function renderResult(customer) {
	    resultDiv.style.display = 'block';
	    resultDiv.innerHTML = `
	        <h3>✅ ${customer.firstName ?? ''} ${customer.lastName ?? ''}</h3>
		        <div class="meta">
	            <span><strong>ID:</strong> ${customer.id ?? '-'}</span>
	            <span><strong>Cuenta:</strong> ${customer.accountNumber ?? '-'}</span>
	            <span><strong>Saldo:</strong> $${customer.balance ?? '0'}</span>
	        </div>
	    `;
	}

	form.addEventListener('submit', async (e) => {
		e.preventDefault();
		resultDiv.style.display = 'none';

		const payload = {
		    firstName: document.getElementById('firstName').value.trim(),
		    lastName: document.getElementById('lastName').value.trim(),
		    accountNumber: document.getElementById('accountNumber').value.trim(),
		    balance: parseFloat(document.getElementById('balance').value),
		};

		if (!payload.firstName || !payload.lastName || !payload.accountNumber || isNaN(payload.balance)) {
		    setStatus('Completa todos los campos correctamente.', 'error');
		    return;
		}

		setStatus('Creando cliente...', '');

		try {
			const res = await fetch(`${API_BASE}/customers`, {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify(payload),
			});

			if (!res.ok) {
				let errMsg = `Error ${res.status} al crear el cliente.`;
				try {
					const errBody = await res.json();
					errMsg = errBody.error || errBody.message || errMsg;
				} catch (_) {}
				setStatus(errMsg, 'error');
				return;
			}

			const data = await res.json();
			setStatus('Cliente creado exitosamente.', 'success');
			renderResult(data);
			form.reset();
		} catch (err) {
			setStatus('No se pudo conectar con el backend. ¿Está corriendo en el puerto 8088?', 'error');
		}
	});
</script>